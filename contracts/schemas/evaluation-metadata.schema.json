{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-workbench.local/contracts/evaluation-metadata.schema.json",
  "title": "EvaluationMetadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId"],
  "properties": {
    "runId": {
      "type": "string",
      "description": "Canonical runId evaluated by this result."
    },
    "modelTrace": {
      "anyOf": [
        { "$ref": "model-trace.schema.json" },
        { "type": "null" }
      ],
      "description": "Single inherited model trace object. Do not expand model fields at metadata top level."
    },
    "evaluatorVersion": {
      "type": ["string", "null"],
      "description": "Evaluator or rubric version."
    },
    "langSmithTraceId": {
      "type": ["string", "null"],
      "description": "External observability id. It does not replace canonical runId."
    }
  }
}
