{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-workbench.local/contracts/objects/run-event-record.schema.json",
  "title": "RunEventRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "run_id",
    "conversation_id",
    "user_id",
    "seq",
    "event_type",
    "payload",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "run_events.id。"
    },
    "run_id": {
      "type": "string",
      "description": "run_events.run_id。"
    },
    "conversation_id": {
      "type": "string",
      "description": "run_events.conversation_id。"
    },
    "user_id": {
      "type": "string",
      "description": "run_events.user_id。"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "Run 内事件序号。"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "run_started",
        "run_reused",
        "step_started",
        "step_completed",
        "step_failed",
        "tool_started",
        "tool_completed",
        "tool_failed",
        "chart_ready",
        "conclusion_delta",
        "conclusion_completed",
        "rag_sources_ready",
        "report_pending",
        "run_completed",
        "run_failed"
      ],
      "description": "持久化事件类型，应与 payload.type 一致；一致性由 boundary fixture 断言覆盖。"
    },
    "payload": {
      "$ref": "../events/run-sse-event-envelope.schema.json"
    },
    "created_at": {
      "type": "string",
      "description": "run_events.created_at。"
    }
  }
}
