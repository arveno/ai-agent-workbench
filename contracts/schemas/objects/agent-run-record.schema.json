{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-workbench.local/contracts/objects/agent-run-record.schema.json",
  "title": "AgentRunRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "conversation_id",
    "user_id",
    "usage_id",
    "client_run_id",
    "mode",
    "status",
    "intent",
    "prompt",
    "plan",
    "data_source_snapshot",
    "chart_data",
    "conclusion",
    "report_state",
    "started_at",
    "completed_at",
    "elapsed_ms",
    "error_message",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "agent_runs.id，canonical runId。"
    },
    "conversation_id": {
      "type": "string",
      "description": "agent_runs.conversation_id。"
    },
    "user_id": {
      "type": "string",
      "description": "agent_runs.user_id。"
    },
    "usage_id": {
      "type": ["string", "null"],
      "description": "agent_run_usage.id。"
    },
    "client_run_id": {
      "type": ["string", "null"],
      "description": "请求幂等 ID。"
    },
    "mode": {
      "type": "string",
      "enum": ["mock", "agent"],
      "description": "持久化 Run 执行模式。"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "running", "completed", "failed", "stopped"],
      "description": "持久化 Run 状态。"
    },
    "intent": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["capability_intro", "data_analysis", "knowledge_qa", "unsupported", "unknown"]
        },
        { "type": "null" }
      ],
      "description": "planner 识别出的 intent。"
    },
    "prompt": {
      "type": ["string", "null"],
      "description": "用户输入。"
    },
    "plan": {
      "anyOf": [
        { "$ref": "run-plan.schema.json" },
        { "$ref": "#/$defs/EmptyObject" }
      ],
      "description": "agent_runs.plan。pending 写入允许空对象，完成态使用 canonical RunPlan。"
    },
    "data_source_snapshot": {
      "$ref": "run-data-source.schema.json"
    },
    "chart_data": {
      "anyOf": [
        { "$ref": "run-chart-data.schema.json" },
        { "$ref": "#/$defs/EmptyObject" }
      ],
      "description": "agent_runs.chart_data。无图表时为 DB persistence 空对象，不允许 null。"
    },
    "conclusion": {
      "type": ["string", "null"],
      "description": "Run 结论文本。"
    },
    "report_state": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["hidden", "pending", "generating", "generated", "skipped", "failed"]
        },
        { "type": "null" }
      ],
      "description": "持久化 report state。"
    },
    "started_at": {
      "type": "string",
      "description": "Run 开始时间。"
    },
    "completed_at": {
      "type": ["string", "null"],
      "description": "Run 完成时间。"
    },
    "elapsed_ms": {
      "type": ["number", "null"],
      "description": "Run 耗时，单位毫秒。"
    },
    "error_message": {
      "type": ["string", "null"],
      "description": "Run 失败时的安全错误信息。"
    },
    "metadata": {
      "$ref": "agent-run-metadata.schema.json"
    }
  },
  "$defs": {
    "EmptyObject": {
      "type": "object",
      "additionalProperties": true,
      "maxProperties": 0,
      "description": "当前 agent_runs pending/no-chart persistence 状态使用的空对象。"
    }
  }
}
