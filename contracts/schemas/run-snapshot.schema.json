{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-workbench.local/contracts/run-snapshot.schema.json",
  "title": "RunSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "conversationId",
    "mode",
    "status",
    "modelTrace",
    "reportState",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Canonical runId. It only points to DB agent_runs.id."
    },
    "conversationId": {
      "type": "string",
      "description": "Conversation owning the run."
    },
    "clientRunId": {
      "type": ["string", "null"],
      "description": "Pending and idempotency id. It is not a business foreign key."
    },
    "usageId": {
      "type": ["string", "null"],
      "description": "Usage record id when persisted."
    },
    "mode": {
      "type": "string",
      "enum": ["mock", "agent"],
      "description": "Run execution mode at the runtime and persistence boundary."
    },
    "status": {
      "type": "string",
      "enum": ["pending", "running", "completed", "failed", "stopped"],
      "description": "Canonical runtime and persistence run status. UI status is mapped in RunViewModel."
    },
    "intent": {
      "type": "string",
      "enum": ["capability_intro", "data_analysis", "knowledge_qa", "unsupported", "unknown"],
      "description": "Planner intent when known."
    },
    "prompt": {
      "type": "string",
      "description": "User prompt captured for this run."
    },
    "plan": {
      "type": "object",
      "additionalProperties": true,
      "description": "Runtime plan snapshot. Plan details are not a UI ViewModel contract."
    },
    "dataSource": {
      "type": "object",
      "additionalProperties": true,
      "description": "Runtime data source snapshot."
    },
    "chartData": {
      "type": "object",
      "additionalProperties": true,
      "description": "Canonical chart payload produced by the run when available."
    },
    "modelTrace": {
      "anyOf": [
        { "$ref": "model-trace.schema.json" },
        { "type": "null" }
      ]
    },
    "agentConclusion": {
      "anyOf": [
        { "$ref": "agent-conclusion.schema.json" },
        { "type": "null" }
      ]
    },
    "reportState": {
      "type": "string",
      "enum": ["hidden", "pending", "generating", "generated", "skipped", "failed"],
      "description": "Report decision state attached to the run boundary."
    },
    "startedAt": {
      "type": "string",
      "description": "Run start timestamp."
    },
    "completedAt": {
      "type": "string",
      "description": "Run completion timestamp."
    },
    "elapsedMs": {
      "type": "number",
      "description": "Elapsed runtime in milliseconds."
    },
    "errorMessage": {
      "type": "string",
      "description": "Failure message for failed or stopped runs."
    },
    "createdAt": {
      "type": "string",
      "description": "Run creation timestamp."
    },
    "updatedAt": {
      "type": "string",
      "description": "Run update timestamp."
    }
  }
}
