{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-workbench.local/contracts/model-trace.schema.json",
  "title": "ModelTrace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selectedModelId",
    "provider",
    "model",
    "latencyMs",
    "usage",
    "costEstimate",
    "fallbackReason",
    "modelErrorType",
    "conclusionSource"
  ],
  "properties": {
    "selectedModelId": {
      "type": "string",
      "description": "Catalog model id selected by the frontend."
    },
    "provider": {
      "type": ["string", "null"],
      "description": "Provider resolved by catalog on the backend."
    },
    "model": {
      "type": ["string", "null"],
      "description": "Provider model name resolved by catalog on the backend."
    },
    "latencyMs": {
      "type": ["number", "null"],
      "description": "Model call latency in milliseconds."
    },
    "usage": {
      "$ref": "#/$defs/ModelUsage"
    },
    "costEstimate": {
      "$ref": "#/$defs/CostEstimate"
    },
    "fallbackReason": {
      "type": ["string", "null"],
      "description": "Fallback reason when conclusionSource is fallback."
    },
    "modelErrorType": {
      "type": ["string", "null"],
      "description": "Normalized model error type."
    },
    "modelHttpStatus": {
      "type": ["number", "null"],
      "description": "HTTP status when the provider reports one."
    },
    "modelErrorMessage": {
      "type": ["string", "null"],
      "description": "Sanitized model error message."
    },
    "conclusionSource": {
      "$ref": "#/$defs/ConclusionSource"
    }
  },
  "$defs": {
    "ConclusionSource": {
      "type": "string",
      "enum": ["model", "fallback", "mock", "none"],
      "description": "Canonical source of a run conclusion."
    },
    "UsageSource": {
      "type": "string",
      "enum": ["provider", "unavailable", "none", "estimated"],
      "description": "Canonical usage source label."
    },
    "PricingSource": {
      "type": "string",
      "enum": ["catalog", "unavailable", "none"],
      "description": "Source of pricing metadata."
    },
    "ModelUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promptTokens",
        "completionTokens",
        "totalTokens",
        "usageAvailable",
        "usageSource",
        "usageUnavailableReason"
      ],
      "properties": {
        "promptTokens": {
          "type": ["number", "null"],
          "description": "Prompt token count when the provider returns it."
        },
        "completionTokens": {
          "type": ["number", "null"],
          "description": "Completion token count when the provider returns it."
        },
        "totalTokens": {
          "type": ["number", "null"],
          "description": "Total token count when the provider returns it."
        },
        "usageAvailable": {
          "type": "boolean",
          "description": "Whether provider usage data is available."
        },
        "usageSource": {
          "$ref": "#/$defs/UsageSource"
        },
        "usageUnavailableReason": {
          "type": ["string", "null"],
          "description": "Explicit reason when usage is unavailable."
        }
      }
    },
    "CostEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimatedCost",
        "currency",
        "pricingUnit",
        "isEstimated",
        "pricingSource",
        "costUnavailableReason"
      ],
      "properties": {
        "estimatedCost": {
          "type": ["number", "null"],
          "description": "Estimated cost amount when pricing is available."
        },
        "currency": {
          "type": ["string", "null"],
          "description": "Currency code for the estimate."
        },
        "pricingUnit": {
          "type": ["string", "null"],
          "description": "Pricing unit used for the estimate."
        },
        "isEstimated": {
          "type": "boolean",
          "description": "Whether the amount is an estimate."
        },
        "pricingSource": {
          "$ref": "#/$defs/PricingSource"
        },
        "costUnavailableReason": {
          "type": ["string", "null"],
          "description": "Explicit reason when cost cannot be estimated."
        }
      }
    }
  }
}
