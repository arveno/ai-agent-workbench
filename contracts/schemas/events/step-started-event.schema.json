{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-workbench.local/contracts/events/step-started-event.schema.json",
  "title": "StepStartedEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "runId", "conversationId", "timestamp", "payload"],
  "properties": {
    "type": {
      "$ref": "run-sse-event-envelope.schema.json#/properties/type"
    },
    "runId": {
      "$ref": "run-sse-event-envelope.schema.json#/properties/runId"
    },
    "conversationId": {
      "$ref": "run-sse-event-envelope.schema.json#/properties/conversationId"
    },
    "timestamp": {
      "$ref": "run-sse-event-envelope.schema.json#/properties/timestamp"
    },
    "payload": {
      "$ref": "run-sse-event-envelope.schema.json#/properties/payload"
    }
  },
  "allOf": [
    {
      "$ref": "run-sse-event-envelope.schema.json"
    },
    {
      "type": "object",
      "required": ["type", "payload"],
      "properties": {
        "type": {
          "const": "step_started",
          "description": "SSE event 类型，表示 Run step 开始执行。"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["step"],
          "description": "step_started 事件业务数据。",
          "properties": {
            "step": {
              "type": "object",
              "additionalProperties": false,
              "required": ["stepId", "title", "description", "startedAt"],
              "description": "开始执行的 step 快照。",
              "properties": {
                "stepId": {
                  "type": "string",
                  "description": "runtime step 稳定 ID。"
                },
                "title": {
                  "type": "string",
                  "description": "step 标题。"
                },
                "description": {
                  "type": "string",
                  "description": "step 说明。"
                },
                "startedAt": {
                  "type": "string",
                  "description": "step 开始时间。"
                },
                "metadata": {
                  "type": "object",
                  "additionalProperties": true,
                  "description": "step runtime metadata。"
                }
              }
            }
          }
        }
      }
    }
  ]
}
