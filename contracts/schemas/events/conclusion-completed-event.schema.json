{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-workbench.local/contracts/events/conclusion-completed-event.schema.json",
  "title": "ConclusionCompletedEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "runId", "conversationId", "timestamp", "payload"],
  "properties": {
    "type": {
      "$ref": "run-sse-event-envelope.schema.json#/properties/type"
    },
    "runId": {
      "$ref": "run-sse-event-envelope.schema.json#/properties/runId"
    },
    "conversationId": {
      "$ref": "run-sse-event-envelope.schema.json#/properties/conversationId"
    },
    "timestamp": {
      "$ref": "run-sse-event-envelope.schema.json#/properties/timestamp"
    },
    "payload": {
      "$ref": "run-sse-event-envelope.schema.json#/properties/payload"
    }
  },
  "allOf": [
    {
      "$ref": "run-sse-event-envelope.schema.json"
    },
    {
      "type": "object",
      "required": ["type", "payload"],
      "properties": {
        "type": {
          "const": "conclusion_completed",
          "description": "SSE event 类型，表示结论生成完成。"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["conclusion", "agentConclusion", "modelTrace"],
          "description": "conclusion_completed 事件业务数据。",
          "properties": {
            "conclusion": {
              "type": "string",
              "description": "当前 runtime 发送的 markdown 结论文本。"
            },
            "agentConclusion": {
              "$ref": "../objects/agent-conclusion.schema.json"
            },
            "modelTrace": {
              "$ref": "../objects/model-trace.schema.json"
            }
          }
        }
      }
    }
  ]
}
