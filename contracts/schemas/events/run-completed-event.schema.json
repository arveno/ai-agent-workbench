{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-workbench.local/contracts/events/run-completed-event.schema.json",
  "title": "RunCompletedEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "runId", "conversationId", "timestamp", "payload"],
  "properties": {
    "type": {
      "$ref": "run-sse-event-envelope.schema.json#/properties/type"
    },
    "runId": {
      "$ref": "run-sse-event-envelope.schema.json#/properties/runId"
    },
    "conversationId": {
      "$ref": "run-sse-event-envelope.schema.json#/properties/conversationId"
    },
    "timestamp": {
      "$ref": "run-sse-event-envelope.schema.json#/properties/timestamp"
    },
    "payload": {
      "$ref": "run-sse-event-envelope.schema.json#/properties/payload"
    }
  },
  "allOf": [
    {
      "$ref": "run-sse-event-envelope.schema.json"
    },
    {
      "type": "object",
      "required": ["type", "payload"],
      "properties": {
        "type": {
          "const": "run_completed",
          "description": "SSE event 类型，表示 Agent Run 正常完成。"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["completedAt", "elapsedMs", "assistantMessageId", "metadata", "modelTrace"],
          "description": "run_completed 事件业务数据。",
          "properties": {
            "completedAt": {
              "type": "string",
              "description": "Run 完成时间。"
            },
            "elapsedMs": {
              "type": "number",
              "description": "Run 执行总耗时，单位毫秒。"
            },
            "assistantMessageId": {
              "type": "string",
              "description": "Run 产出的 assistant message ID。"
            },
            "metadata": {
              "type": "object",
              "additionalProperties": true,
              "description": "Run completion runtime metadata。"
            },
            "modelTrace": {
              "$ref": "../objects/model-trace.schema.json"
            }
          }
        }
      }
    }
  ]
}
