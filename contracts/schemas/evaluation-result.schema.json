{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-workbench.local/contracts/evaluation-result.schema.json",
  "title": "EvaluationResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "caseId",
    "conversationId",
    "runId",
    "verdict",
    "badCaseReason",
    "humanNote",
    "actualSummary",
    "modelTrace",
    "toolSummary",
    "ragSummary",
    "reportSummary",
    "metadata",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Evaluation result 主 ID。"
    },
    "caseId": {
      "type": "string",
      "description": "Evaluation case ID。"
    },
    "conversationId": {
      "type": ["string", "null"],
      "description": "被评估 Run 关联的 conversation。"
    },
    "runId": {
      "type": "string",
      "description": "该 evaluation result 评估的 canonical runId。"
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "unknown"],
      "description": "人工或 evaluator 给出的评估结论。"
    },
    "badCaseReason": {
      "type": ["string", "null"],
      "description": "verdict 为 fail 时的 bad case 原因。"
    },
    "humanNote": {
      "type": ["string", "null"],
      "description": "可选的人工 review 备注。"
    },
    "actualSummary": {
      "type": "object",
      "additionalProperties": true,
      "description": "evaluation 实际输出摘要。"
    },
    "modelTrace": {
      "type": "object",
      "additionalProperties": true,
      "description": "持久化的 eval_results.model_trace 快照；canonical metadata.modelTrace 由 EvaluationMetadata 定义。"
    },
    "toolSummary": {
      "type": "array",
      "items": {},
      "description": "evaluation tool 摘要。"
    },
    "ragSummary": {
      "type": "object",
      "additionalProperties": true,
      "description": "evaluation RAG 摘要。"
    },
    "reportSummary": {
      "type": "object",
      "additionalProperties": true,
      "description": "evaluation report 摘要。"
    },
    "metadata": {
      "$ref": "evaluation-metadata.schema.json"
    },
    "createdAt": {
      "type": "string",
      "description": "evaluation result 创建时间。"
    },
    "updatedAt": {
      "type": "string",
      "description": "evaluation result 更新时间。"
    }
  }
}
