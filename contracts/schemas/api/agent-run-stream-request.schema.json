{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-workbench.local/contracts/api/agent-run-stream-request.schema.json",
  "title": "AgentRunStreamRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["conversationId"],
  "properties": {
    "conversationId": {
      "type": "string",
      "minLength": 1,
      "description": "Target conversation ID."
    },
    "prompt": {
      "type": "string",
      "description": "User prompt for the Agent Run. Runtime may apply a default when empty."
    },
    "selectedModelId": {
      "type": "string",
      "minLength": 1,
      "description": "Selected model catalog ID."
    },
    "clientRunId": {
      "type": ["string", "null"],
      "description": "Optional client idempotency ID."
    },
    "provider": {
      "type": "string",
      "enum": ["cloudbase_mysql"],
      "description": "Optional data provider field accepted by the request boundary; current runtime uses cloudbase_mysql."
    }
  }
}
