{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-workbench.local/contracts/api/agent-run-quota-finish-request.schema.json",
  "title": "AgentRunQuotaFinishRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "usageId", "status"],
  "properties": {
    "action": {
      "type": "string",
      "const": "finish",
      "description": "Quota action."
    },
    "usageId": {
      "type": "string",
      "minLength": 1,
      "description": "Agent Run usage ID."
    },
    "status": {
      "type": "string",
      "enum": ["completed", "failed", "stopped"],
      "description": "Final usage status accepted by the current quota endpoint."
    },
    "errorCode": {
      "type": ["string", "null"],
      "description": "Optional finish error code."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Usage finish metadata accepted by the current quota endpoint."
    }
  }
}
