{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-workbench.local/contracts/api/evaluation-list-response.schema.json",
  "title": "EvaluationListResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "data"],
  "properties": {
    "ok": {
      "type": "boolean",
      "const": true
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["results"],
      "properties": {
        "results": {
          "type": "array",
          "items": { "$ref": "../objects/evaluation-result.schema.json" }
        }
      }
    }
  }
}
