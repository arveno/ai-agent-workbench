{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-workbench.local/contracts/api/report-status-update-request.schema.json",
  "title": "ReportStatusUpdateRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["conversationId", "runId", "reportState"],
  "properties": {
    "conversationId": {
      "type": "string",
      "minLength": 1,
      "description": "Conversation that owns the run."
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical runId whose report state is updated."
    },
    "reportState": {
      "type": "string",
      "enum": ["hidden", "pending", "generating", "generated", "skipped", "failed"],
      "description": "Run report state accepted by the current reports endpoint."
    }
  }
}
